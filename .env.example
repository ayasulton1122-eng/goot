# Local / production environment template.
# NEVER commit your real values.

NODE_ENV=production
PORT=10000

# Render supplies this automatically when using render.yaml.
DATABASE_URL=

# Set a NEW demo-only admin key in Render.
ADMIN_KEY=

# After the first Render deploy, set this to your public demo URL, for example:
# https://goot-resorts-demo.onrender.com
ALLOWED_ORIGINS=
